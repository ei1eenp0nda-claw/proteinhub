# ProteinHub Environment Configuration
# Copy this file to .env and update the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=proteinhub
POSTGRES_USER=proteinhub
# IMPORTANT: Change this to a strong password!
POSTGRES_PASSWORD=change_me_to_a_secure_password

# ============================================
# Security Configuration
# ============================================
# Generate with: openssl rand -base64 32
SECRET_KEY=your-256-bit-secret-key-change-this
JWT_SECRET_KEY=your-different-jwt-secret-key-change-this

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://proteinhub.example.com,https://www.proteinhub.example.com

# ============================================
# Gunicorn Configuration
# ============================================
# Number of workers (recommended: 2-4 x CPU cores)
WORKERS=4
# Worker timeout in seconds
WORKER_TIMEOUT=120

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
# Options: text, json
LOG_FORMAT=json

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# ============================================
# Redis Configuration (for caching)
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# Email Configuration (optional)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_TLS=true

# ============================================
# Monitoring (optional)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn
# HEALTH_CHECK_TOKEN=your-secret-token
